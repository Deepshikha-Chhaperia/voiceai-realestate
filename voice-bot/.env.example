# ── MULTILINGUAL PRIMARY STT / LLM / TTS ────────────────────────────────
# Two verified stacks are actually configured in config.yaml, switched via
# active_providers:
#
#   STACK A: STT=deepgram (nova-3, multi)  LLM=groq (llama-3.1-8b-instant)  TTS=sarvam (bulbul:v3)
#   STACK B: STT=sarvam (saaras:v3)        LLM=groq (llama-3.1-8b-instant)  TTS=murf (falcon-2)
#
# Both use Groq for the LLM leg deliberately, not Sarvam: Sarvam's LLM API
# documents max_completion_tokens as an unsupported, silently-dropped
# parameter, which would mean your response-length/cost cap silently
# doesn't apply. Groq's API correctly honors it. See config.yaml for the
# full reasoning and the exact active_providers block for each stack.
#
SARVAM_API_KEY=your_sarvam_key_here
MURF_API_KEY=your_murf_key_here

# ── FALLBACK / ALTERNATIVE STT PROVIDERS ─────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_key_here            # nova-3, language=multi (en/hi/te code-switching — verify Telugu coverage directly with Deepgram, see config.yaml)
OPENAI_API_KEY=your_openai_key_here                # Whisper-1
NVIDIA_API_KEY=your_nvidia_parakeet_key_here        # NOT YET WIRED: no "nvidia" entry exists in config.yaml's providers.stt registry — setting this key alone does nothing until that entry is added

# ── FALLBACK / ALTERNATIVE LLM PROVIDERS ─────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here          # qwen/qwen3.8-27b ($0.15/$2.00 per 1M tokens)
CEREBRAS_API_KEY=your_cerebras_key_here             # gpt-oss-120b
GROQ_API_KEY=your_groq_key_here                    # llama-3.1-8b-instant (low latency)

# ── FALLBACK / ALTERNATIVE TTS PROVIDERS ─────────────────────────────────
CARTESIA_API_KEY=your_cartesia_key_here             # NOT YET WIRED: no "cartesia" entry exists in config.yaml's providers.tts registry — setting this key alone does nothing until that entry is added
ELEVENLABS_API_KEY=your_elevenlabs_key_here         # Strong en-IN/hi-IN, limited te-IN
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── SERVER SETTINGS ───────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
OUTBOUND_API_KEY=your_outbound_api_key_here         # fail-closed auth for /outbound

REDIS_URL=redis://localhost

# ── TELEPHONY (Vobiz) ─────────────────────────────────────────────────────
VOBIZ_BASE_URL=https://api.vobiz.ai
VOBIZ_AUTH_ID=your_auth_id_here
VOBIZ_AUTH_TOKEN=your_auth_token_here
VOBIZ_FROM_NUMBER=14155551234

# ── CALL RECORDS / DASHBOARD (lead_state.py, main.py) ────────────────────
# Leave both unset for local/demo use -- SQLite under outputs/calls.db,
# zero setup. Set DATABASE_URL only once you're running more than one
# server instance behind a load balancer (SQLite is a local file; two
# instances would each keep their own, silently diverging, call history).
# LEAD_DB_PATH=outputs/calls.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DASHBOARD_API_KEY=your_dashboard_api_key_here       # gates GET /calls, /calls/{id}, /calls/export.csv, /campaigns/{id}/summary — falls back to OUTBOUND_API_KEY if unset

# ── POSTGRES (docker-compose) ─────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password_here    # used in docker-compose.yml; also update DATABASE_URL if connecting directly

# ── POST-CALL ANALYSIS (call_analytics.py) ────────────────────────────────
# Reuses GROQ_API_KEY above. ANALYSIS_MODEL defaults to llama-3.1-8b-instant
# (cheap/fast, deliberately smaller than the conversational model) if unset.
# ANALYSIS_MODEL=llama-3.1-8b-instant

# ── CRM EXPORT (google_sheets_export.py, call_analytics.py) ──────────────
# Both destinations are optional and independent -- set either, both, or
# neither. Everything here is a no-op with zero config.
GOOGLE_SHEETS_SPREADSHEET_ID=                       # the long ID in the sheet's URL, blank = Sheets export disabled
GOOGLE_SHEETS_SHEET_NAME=Calls                      # tab name; created automatically with a header row on first write
GOOGLE_SHEETS_CREDENTIALS_JSON=                     # full service-account JSON key as one line, for container/secret-manager deployments
GOOGLE_APPLICATION_CREDENTIALS=                     # OR a file path to the same JSON key -- use one or the other, not both
CRM_WEBHOOK_URL=                                    # optional: POSTs the same call record to any webhook (Zapier/Make/your own CRM's inbound hook)

# ── WEBHOOK SECURITY ──────────────────────────────────────────────────────
# Production: all three must be set. Boot is refused without them when ENV=prod.
META_APP_SECRET=                                    # Meta App Secret for X-Hub-Signature-256 verification on /webhooks/meta
META_VERIFY_TOKEN=                                  # Random token you register in Meta Business > Webhooks; no default
WEBSITE_WEBHOOK_SECRET=                             # Shared secret sent as X-Webhook-Secret header from your website form
WS_TOKEN=                                           # Bearer token required on /ws WebSocket connect (query param ?token= or Authorization header)