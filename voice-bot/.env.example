# Copy to .env and fill in. NEVER commit .env.
# Generate any secret below with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Tags: [required-in-production] must be set | [set-by-compose] docker-compose sets it, leave unset in .env | [optional]
#
# Local demo needs none of this: LOCAL_DEMO=1 python main.py  (SQLite + in-memory, auto-generated secrets)
# Production: docker compose up -d

# ---- AI providers (see config.yaml active_providers; set the keys for the providers you use) ----
SARVAM_API_KEY=          # [required-in-production] default STT/TTS
GROQ_API_KEY=            # [required-in-production] default LLM + post-call analysis
DEEPGRAM_API_KEY=        # [optional] alternative STT
OPENAI_API_KEY=          # [optional] alternative STT (Whisper)
OPENROUTER_API_KEY=      # [optional] alternative LLM
CEREBRAS_API_KEY=        # [optional] LLM fallback
MURF_API_KEY=            # [optional] alternative TTS
ELEVENLABS_API_KEY=      # [optional] alternative TTS
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # [optional]
MARKET=india             # [optional] profile in profiles/<market>.yaml

# ---- Telephony (Vobiz) ----
VOBIZ_BASE_URL=https://api.vobiz.ai  # [optional]
VOBIZ_AUTH_ID=           # [required-in-production] for outbound calls
VOBIZ_AUTH_TOKEN=        # [required-in-production] also verifies Vobiz webhook signatures on /inbound and /outbound-answer
VOBIZ_FROM_NUMBER=       # [required-in-production] for outbound calls
VERIFY_VOBIZ_SIGNATURE=true  # [optional] keep true; scheme must be confirmed with one real call

# ---- Public URL ----
PUBLIC_HOST=             # [required-in-production] externally reachable host, e.g. bot.example.com (no scheme)
FORCE_WSS=true           # [optional] true behind a TLS-terminating proxy so Vobiz gets wss://
PUBLIC_BASE_URL=         # [optional] full https URL used in Telegram alert links; defaults to https://PUBLIC_HOST

# ---- Auth secrets ----
WS_TOKEN=                # [required-in-production] 24+ chars; generate with the command above
DASHBOARD_API_KEY=       # [required-in-production] 24+ chars; generate with the command above
OUTBOUND_API_KEY=        # [required-in-production] guards POST /outbound (endpoint returns 500 if unset); generate with the command above
DASHBOARD_ORIGIN=        # [optional] comma-separated browser origins allowed by CORS

# ---- Server ----
HOST=127.0.0.1           # [set-by-compose] compose and the Dockerfile set 0.0.0.0; keep 127.0.0.1 for local runs
PORT=8000                # [optional]
DATA_DIR=outputs         # [set-by-compose] compose sets /data (named volume)
MAX_CONCURRENT_CALLS=50  # [optional]

# ---- Databases ----
POSTGRES_PASSWORD=       # [required-in-production] used by compose for postgres and DATABASE_URL; generate with the command above
REDIS_PASSWORD=          # [required-in-production] used by compose for redis and REDIS_URL; generate with the command above
DATABASE_URL=            # [set-by-compose] postgresql+asyncpg://...; leave unset locally for SQLite under DATA_DIR
REDIS_URL=               # [set-by-compose] redis://:<password>@redis:6379/0; leave unset locally for in-memory

# ---- Post-call CRM / notifications ----
GOOGLE_SHEETS_SPREADSHEET_ID=      # [optional] blank disables Sheets export
GOOGLE_SHEETS_SHEET_NAME=Calls     # [optional]
GOOGLE_SHEETS_CREDENTIALS_JSON=    # [optional] service-account JSON on one line
GOOGLE_APPLICATION_CREDENTIALS=    # [optional] OR a path to the same JSON key
CRM_WEBHOOK_URL=                   # [optional] POSTs each call record to this URL
TELEGRAM_BOT_TOKEN=                # [optional]
TELEGRAM_CHAT_ID=                  # [optional]
ANALYSIS_MODEL=llama-3.1-8b-instant  # [optional]

# ---- Local demo only (never set in production) ----
# LOCAL_DEMO=1           # [optional] boots without secrets/services, loopback only, auth still enforced
# ---- Dormant Meta automation (no value here enables sends alone) ----
WHATSAPP_AUTOMATION_ENABLED=false
WHATSAPP_API_VERSION=                 # explicit supported version
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SETUP_CONFIRMED=false # only after HTTPS verification, messages subscription, app Live
# JSON values, no secret recipient overrides:
# WHATSAPP_TEMPLATE_MAP_JSON={"brochure":{"name":"approved_brochure","language":"en_US","body_fields":["name","brochure_url","floorplan_url"]},"location":{"name":"approved_location","language":"en_US","body_fields":["name","location_url"]}}
WHATSAPP_TEMPLATE_MAP_JSON=
# WHATSAPP_VERIFIED_LINKS_JSON={"brochure_url":{"url":"https://YOUR-REAL-HOST/brochure.pdf","verified":true},"floorplan_url":{"url":"https://YOUR-REAL-HOST/floorplans.pdf","verified":true},"location_url":{"url":"https://YOUR-VERIFIED-LOCATION-LINK","verified":true}}
WHATSAPP_VERIFIED_LINKS_JSON=
